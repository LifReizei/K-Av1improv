{
  "id": "animeav1-improved",
  "name": "AnimeAV1 Improved",
  "version": "2.1.1",
  "apiVersion": 7,
  "entry": "plugin.js",
  "description": "Anime en español latino y subtitulado",
  "color": "#000000",
  "section": {
   "label": "AnimeAV1 Improved"
  },
  "categories": [
    "anime"
  ],
  "hosts": [
    "animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "jeremyparticipantanything.com",
    "teresapoliticallearn.com",
    "mp4upload.com",
    "yourupload.com",
    "*.mp4upload.com",
    "*.yourupload.com",
    "vidcache.net",
    "streamtape.com",
    "tapecontent.net",
    "*.tapecontent.net",
    "*.uns.bio"
  ],
  "streamHosts": "any",
  "capabilities": [
    "home",
    "browse",
    "search",
    "episodes",
    "resolve",
    "download"
  ],
  "settings": [
    {
      "key": "idioma",
      "label": "Idioma",
      "type": "select",
      "default": "sub",
      "options": [
        { "value": "sub", "label": "Subtitulado" },
        { "value": "dub", "label": "Doblado" },
        { "value": "dub-sub", "label": "Subtitulado (si no hay doblado)" }
      ]
    },
    {
      "key": "servidor",
      "label": "Servidor preferido",
      "type": "select",
      "default": "voe",
      "options": [
	  	{ "value": " ", "label": "Tv" },
        { "value": "voe", "label": "720 Server: voe" },
        { "value": "upnshare", "label": "1080 Server: upnshare" },
		{ "value": " ", "label": "Standard" },
        { "value": "yourupload", "label": "MP4 Server: yourupload" },
		{ "value": "streamtape", "label": "MP4 Server: StreamTape" },
		{ "value": " ", "label": "HIFI" },
        { "value": "mp4upload", "label": "AV1 Server: mp4upload" }
      ]
    }
  ],
  "icon": "icon.png"
}
