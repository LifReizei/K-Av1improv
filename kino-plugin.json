{
  "id": "animeav1-improved",
  "name": "AnimeAV1 Improved",
  "version": "2.1.3",
  "versionCode": "2.1.3",
  "versionName": "2.1.3",
  "apiVersion": 5,
  "author": "LifReizei",
  "description": "Anime en español latino y subtitulado",
  "langs": ["es"],
  "nsfw": false,
  "entry": "plugin.js",
  "color": "#000000",
  "section": {
    "label": "AnimeAV1 Improved"
  },
  "categories": ["anime"],
  "hosts": [
    "animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "jeremyparticipantanything.com",
    "teresapoliticallearn.com",
    "mp4upload.com",
    "yourupload.com",
    "*.mp4upload.com",
    "*.yourupload.com",
    "vidcache.net",
    "streamtape.com",
    "tapecontent.net",
    "*.tapecontent.net",
    "*.uns.bio"
  ],
  "streamHosts": ["any"],
  "capabilities": [
    "home",
    "browse",
    "search",
    "episodes",
    "resolve",
    "download"
  ],
  "settings": [
    {
      "key": "idioma",
      "label": "Idioma",
      "type": "select",
      "default": "sub",
      "options": [
        { "value": "sub", "label": "Subtitulado" },
        { "value": "dub", "label": "Doblado" },
        { "value": "dub-sub", "label": "Subtitulado (si no hay doblado)" }
      ]
    },
    {
      "key": "servidor",
      "label": "Servidor preferido",
      "type": "select",
      "default": "voe",
      "options": [
        { "value": "voe", "label": "Tv - 720 Server: voe" },
        { "value": "upnshare", "label": "Tv - 1080 Server: upnshare" },
        { "value": "yourupload", "label": "Standard - MP4 Server: yourupload" },
        { "value": "streamtape", "label": "Standard - MP4 Server: StreamTape" },
        { "value": "mp4upload", "label": "HIFI - AV1 Server: mp4upload" }
      ]
    }
  ],
  "icon": "icon.png"
}
