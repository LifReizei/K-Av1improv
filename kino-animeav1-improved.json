// Kino Plugin: AnimeAV1 - Mejora completa para mostrar todos los episodios y múltiples temporadas
// Basado en: https://github.com/cuentademo051092/kino-plugin-animeav1

const BASE = "https://raw.githubusercontent.com/cuentademo051092/kino-plugin-animeav1/main/";

/**
 * Kino Plugin: AnimeAV1 - Mejora completa
 * Mejoras:
 * - Muestra todos los episodios de una serie
 * - Separa y organiza por temporadas (seasons)
 * - Mejora la interfaz en la vista de la serie
 * - Soporte para múltiples temporadas con orden cronológico
 * - Integración completa con Kino's API
 */

const PLUGIN = {
  id: "animeav1",
  name: "AnimeAV1 - Plugin Mejorado",
  version: "1.7.0",
  apiVersion: 7,
  entry: "plugin.js",
  description: "Anime en español latino (y subtitulado si no hay) desde animeav1.com, con catálogo en Inicio y Categorías. Mejora completa para mostrar todos los episodios y múltiples temporadas.",
  color: "#8E6BFF",
  section: {
    label: "AnimeAV1"
  },
  categories: [
    "anime"
  ],
  hosts: [
    "animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "jeremyparticipantanything.com",
    "teresapoliticallearn.com",
    "mp4upload.com",
    "yourupload.com",
    "*.mp4upload.com",
