/**
 * Función para obtener todos los episodios de una serie
 * Devuelve una lista ordenada por temporada y episodio
 */
async function getAllEpisodes(seriesId, userId) {
  try {
    // Consulta a la API de Kino para obtener detalles de la serie
    const response = await fetch(
      `${BASE}/api/series/${seriesId}/episodes`,
      {
        method: "GET",
        headers: {
          "Authorization": `Bearer ${userId}`,
          "Accept": "application/json"
        }
      }
    );
    
    if (!response.ok) {
      throw new Error(`Error obteniendo episodios: ${response.status}`);
    }
    
    const data = await response.json();
    
    if (!data || !Array.isArray(data)) {
      throw new Error("No se encontraron episodios");
    }
    
    // Ordenar por temporada y luego por episodio
    const sortedEpisodes = [...data].sort((a, b) => {
      // Primero por año/season, luego por número de episodio
      if (a.season !== b.season) return a.season - b.season;
      if (a.episode !== b.episode) return a.episode - b.episode;
      return a.id - b.id;
    });
    
    return sortedEpisodes;
  } catch (error) {
    console.error("Error en getAllEpisodes:", error);
    throw error;
  }
}

/**
 * Función para obtener la información de una serie
 */
async function getSeriesInfo(seriesId) {
  try {
    const response = await fetch(
      `${BASE}/api/series/${seriesId}`,
      {
        method: "GET",
        headers: {
          "Authorization": `Bearer ${userId}`,
          "Accept": "application/json"
        }
      }
    );
    
    if (!response.ok) {
      throw new Error(`Error obteniendo info de serie: ${response.status}`);
    }
    
    return await response.json();
  } catch (error) {
    console.error("Error en getSeriesInfo:", error);
    throw error;
  }
}

/**
 * Función principal del plugin - maneja la lógica de la interfaz
 */
async function handleRequest(request) {
  try {
    const { seriesId, userId, searchQuery, sortBy } = request.body;
    
    // Si se busca por título
    if (searchQuery) {
      const response = await fetch(
        `${BASE}/api/search?q=${encodeURIComponent(searchQuery)}`,
        {
          method: "GET",
          headers: {
            "Authorization": `Bearer ${userId}`,
            "Accept": "application/json"
          }
        }
      );
      
      if (!response.ok) {
        throw new Error(`Error en búsqueda: ${response.status}`);
      }
      
      const data = await response.json();
      return {
        success: true,
        data: data.results || [],
        message: `Buscando "${searchQuery}"`
      };
    }
    
    // Si se selecciona una serie específica
    if (seriesId) {
      const series = await getSeriesInfo(seriesId);
      
      if (!series) {
        return {
          success: false,
          error: "Serie no encontrada"
        };
      }
      
      // Obtener todos los episodios
      const episodes = await getAllEpisodes(seriesId, userId);
      
      return {
        success: true,
        data: {
          seriesId,
          title: series.name,
          totalEpisodes: episodes.length,
          episodes: episodes,
          sortBy: sortBy || "release_date"
        }
      };
    }
    
    // Si se pide la lista de series
    return {
      success: true,
      data: [
        {
          id: seriesId,
          name: series.name,
          type: series.type,
          totalEpisodes: series.episodeCount || 0,
          sortBy: series.sortBy || "release_date"
        } for (const series of PLUGIN.categories) {
          // Simplificado: solo iteramos las categorías principales
        }
      ]
    };
  } catch (error) {
    console.error("Error en handleRequest:", error);
    return {
      success: false,
      error: error.message
    };
  }
}

module.exports = PLUGIN;
